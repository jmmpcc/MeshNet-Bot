# =============================================================================
# MeshNet-Bot · Transporte del nodo MeshCore Companion
# =============================================================================
#
# Este bloque puede incorporarse al .env principal sin modificar RADIO_PROFILE,
# mapas de canales, BBS, APRS, correo ni bridges.
#
# MESHCORE_MODE decide únicamente cómo conecta MeshNet-Bot con el Companion.
# Valores documentados en esta plantilla: tcp | serial
#
# IMPORTANTE:
# - MESH_TRANSPORT pertenece a Meshtastic y NO selecciona el transporte MeshCore.
# - Se pueden conservar simultáneamente los parámetros TCP y Serial.
# - Solo se utiliza el bloque correspondiente al MESHCORE_MODE activo.
# =============================================================================

MESHCORE_ENABLE=1

# -----------------------------------------------------------------------------
# SELECCIÓN ACTIVA
# -----------------------------------------------------------------------------
# tcp    -> Companion MeshCore accesible por IP.
# serial -> Serial Companion conectado al host por USB/UART.
MESHCORE_MODE=tcp

# -----------------------------------------------------------------------------
# PARÁMETROS TCP
# -----------------------------------------------------------------------------
# Se utilizan únicamente cuando MESHCORE_MODE=tcp.
MESHCORE_TCP_HOST=192.168.1.21
MESHCORE_TCP_PORT=5000

# -----------------------------------------------------------------------------
# PARÁMETROS SERIAL
# -----------------------------------------------------------------------------
# Se utilizan únicamente cuando MESHCORE_MODE=serial.
# El puerto real debe comprobarse en el host con:
#   ls -l /dev/ttyACM* /dev/ttyUSB* 2>/dev/null
#
# Ejemplos habituales:
#   /dev/ttyUSB0  -> adaptador USB-UART
#   /dev/ttyACM0  -> USB CDC/ACM
#
# El firmware del nodo debe ser MeshCore Serial Companion. Que Linux consiga
# abrir el puerto no demuestra que el protocolo Companion esté disponible.
MESHCORE_SERIAL_PORT=/dev/ttyUSB0
MESHCORE_SERIAL_BAUD=115200

# -----------------------------------------------------------------------------
# EJEMPLO: TCP
# -----------------------------------------------------------------------------
# MESHCORE_MODE=tcp
# MESHCORE_TCP_HOST=192.168.1.21
# MESHCORE_TCP_PORT=5000

# -----------------------------------------------------------------------------
# EJEMPLO: SERIAL
# -----------------------------------------------------------------------------
# MESHCORE_MODE=serial
# MESHCORE_SERIAL_PORT=/dev/ttyUSB0
# MESHCORE_SERIAL_BAUD=115200
