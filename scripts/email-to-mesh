#!/usr/bin/env bash
set -euo pipefail

SERVICE="${EMAIL_TO_MESH_SERVICE:-email-to-mesh}"
SCRIPT_PATH="${EMAIL_TO_MESH_SCRIPT:-/app/source/email_to_mesh.py}"

usage() {
  cat <<'HELP'
Uso:
  scripts/email-to-mesh <comando> [argumentos]

Comandos rápidos (estilo bot):
  mail_contactos
  mail_add <contacto> <correo>
  mail_edit <contacto|numero> <correo>
  mail_del <contacto|numero>
  mail <contacto|numero> <texto mensaje...>

Comandos originales de email-to-mesh:
  contacts | contact-add | contact-edit | contact-del | send

Ejemplos:
  scripts/email-to-mesh mail_contactos
  scripts/email-to-mesh mail_add eb2eas eb2eas@example.org
  scripts/email-to-mesh mail eb2eas Mensaje desde CLI sin comillas
  scripts/email-to-mesh mail 1 Mensaje al primer contacto

Variables opcionales:
  EMAIL_TO_MESH_SERVICE  Servicio docker compose (defecto: email-to-mesh)
  EMAIL_TO_MESH_SCRIPT   Ruta del script en el contenedor (defecto: /app/source/email_to_mesh.py)
HELP
}

if [[ "${1:-}" == "" || "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
  usage
  exit 0
fi

if docker compose version >/dev/null 2>&1; then
  exec docker compose exec -T "$SERVICE" python "$SCRIPT_PATH" "$@"
elif command -v docker-compose >/dev/null 2>&1; then
  exec docker-compose exec -T "$SERVICE" python "$SCRIPT_PATH" "$@"
else
  echo "ERROR: no se encontró 'docker compose' ni 'docker-compose'" >&2
  exit 127
fi
