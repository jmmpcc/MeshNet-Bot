[Unit]
Description=MeshNet ControlPanel independiente
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=meshnet
Group=meshnet
WorkingDirectory=/home/meshnet/MeshNet-Bot/tools/ControlPanel
Environment=CONTROLPANEL_HOST=127.0.0.1
Environment=CONTROLPANEL_PORT=8790
EnvironmentFile=-/home/meshnet/.config/meshnet-control-panel.env
ExecStart=/home/meshnet/MeshNet-Bot/tools/ControlPanel/.venv/bin/python control_panel.py
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
