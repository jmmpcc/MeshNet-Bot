// Instalar como /etc/polkit-1/rules.d/50-meshnet-control-panel.rules.
polkit.addRule(function(action, subject) {
    var allowedUnits = [
        "meshnet-farmacias-api.service",
        "meshnet-emergencias-api.service"
    ];
    var allowedVerbs = ["start", "stop", "restart"];
    var unit = action.lookup("unit");
    var verb = action.lookup("verb");
    if (action.id == "org.freedesktop.systemd1.manage-units" &&
        subject.user == "meshnet" &&
        allowedUnits.indexOf(unit) >= 0 &&
        allowedVerbs.indexOf(verb) >= 0) {
        return polkit.Result.YES;
    }
});
