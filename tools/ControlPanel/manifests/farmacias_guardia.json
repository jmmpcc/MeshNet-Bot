{
  "id": "farmacias_guardia",
  "name": "Farmacias de guardia",
  "description": "Consultas, actualización, publicación y servicio API.",
  "url": "http://127.0.0.1:8788",
  "url_env": "FARMACIAS_PANEL_URL",
  "docker_profile": "farmacias",
  "actions": [
    {
      "id": "api_status",
      "name": "Estado API",
      "kind": "systemd",
      "unit": "meshnet-farmacias-api.service",
      "operation": "status",
      "docker_argv": [
        "docker",
        "compose",
        "-f",
        "${REPO}/docker-compose.rpi.yml",
        "--profile",
        "farmacias",
        "ps",
        "farmacias"
      ]
    },
    {
      "id": "api_start",
      "name": "Iniciar API",
      "kind": "systemd",
      "unit": "meshnet-farmacias-api.service",
      "operation": "start",
      "mutating": true,
      "docker_argv": [
        "docker",
        "compose",
        "-f",
        "${REPO}/docker-compose.rpi.yml",
        "--profile",
        "farmacias",
        "up",
        "-d",
        "farmacias",
        "farmacias-check",
        "farmacias-daily"
      ]
    },
    {
      "id": "api_stop",
      "name": "Detener API",
      "kind": "systemd",
      "unit": "meshnet-farmacias-api.service",
      "operation": "stop",
      "mutating": true,
      "confirm": true,
      "docker_argv": [
        "docker",
        "compose",
        "-f",
        "${REPO}/docker-compose.rpi.yml",
        "--profile",
        "farmacias",
        "stop",
        "farmacias",
        "farmacias-check",
        "farmacias-daily"
      ]
    },
    {
      "id": "api_restart",
      "name": "Reiniciar API",
      "kind": "systemd",
      "unit": "meshnet-farmacias-api.service",
      "operation": "restart",
      "mutating": true,
      "confirm": true,
      "docker_argv": [
        "docker",
        "compose",
        "-f",
        "${REPO}/docker-compose.rpi.yml",
        "--profile",
        "farmacias",
        "restart",
        "farmacias",
        "farmacias-check",
        "farmacias-daily"
      ]
    },
    {
      "id": "timers",
      "name": "Planificadores",
      "kind": "command",
      "argv": [
        "systemctl",
        "list-timers",
        "--all",
        "meshnet-farmacias-daily.timer",
        "meshnet-farmacias-check.timer"
      ],
      "docker_argv": [
        "docker",
        "compose",
        "-f",
        "${REPO}/docker-compose.rpi.yml",
        "--profile",
        "farmacias",
        "ps",
        "farmacias-check",
        "farmacias-daily"
      ]
    },
    {
      "id": "status",
      "name": "Estado de datos",
      "kind": "command",
      "argv": [
        "${PYTHON}",
        "${REPO}/tools/farmacias_guardia/farmacias_guardia.py",
        "status"
      ],
      "docker_argv": [
        "docker",
        "compose",
        "-f",
        "${REPO}/docker-compose.rpi.yml",
        "--profile",
        "farmacias",
        "exec",
        "-T",
        "farmacias",
        "python",
        "-u",
        "/app/tools/farmacias_guardia/farmacias_guardia.py",
        "status"
      ]
    },
    {
      "id": "preview",
      "name": "Ver farmacias",
      "kind": "command",
      "argv": [
        "${PYTHON}",
        "${REPO}/tools/farmacias_guardia/farmacias_guardia.py",
        "preview"
      ],
      "docker_argv": [
        "docker",
        "compose",
        "-f",
        "${REPO}/docker-compose.rpi.yml",
        "--profile",
        "farmacias",
        "exec",
        "-T",
        "farmacias",
        "python",
        "-u",
        "/app/tools/farmacias_guardia/farmacias_guardia.py",
        "preview"
      ]
    },
    {
      "id": "fetch",
      "name": "Actualizar datos",
      "kind": "command",
      "argv": [
        "${PYTHON}",
        "${REPO}/tools/farmacias_guardia/farmacias_guardia.py",
        "fetch"
      ],
      "timeout": 90,
      "mutating": true,
      "docker_argv": [
        "docker",
        "compose",
        "-f",
        "${REPO}/docker-compose.rpi.yml",
        "--profile",
        "farmacias",
        "exec",
        "-T",
        "farmacias",
        "python",
        "-u",
        "/app/tools/farmacias_guardia/farmacias_guardia.py",
        "fetch"
      ]
    },
    {
      "id": "check",
      "name": "Comprobar cambios",
      "kind": "command",
      "argv": [
        "${PYTHON}",
        "${REPO}/tools/farmacias_guardia/farmacias_guardia.py",
        "check"
      ],
      "timeout": 90,
      "mutating": true,
      "docker_argv": [
        "docker",
        "compose",
        "-f",
        "${REPO}/docker-compose.rpi.yml",
        "--profile",
        "farmacias",
        "exec",
        "-T",
        "farmacias",
        "python",
        "-u",
        "/app/tools/farmacias_guardia/farmacias_guardia.py",
        "check"
      ]
    },
    {
      "id": "publish",
      "name": "Publicar ahora",
      "kind": "command",
      "argv": [
        "${PYTHON}",
        "${REPO}/tools/farmacias_guardia/farmacias_guardia_scoped.py",
        "send",
        "--force"
      ],
      "timeout": 120,
      "mutating": true,
      "confirm": true,
      "docker_argv": [
        "docker",
        "compose",
        "-f",
        "${REPO}/docker-compose.rpi.yml",
        "--profile",
        "farmacias",
        "exec",
        "-T",
        "farmacias",
        "python",
        "-u",
        "/app/tools/farmacias_guardia/farmacias_guardia_scoped.py",
        "send",
        "--force"
      ]
    },
    {
      "id": "doctor",
      "name": "Diagnóstico",
      "kind": "command",
      "argv": [
        "${PYTHON}",
        "${REPO}/tools/farmacias_guardia/farmacias_guardia.py",
        "doctor"
      ],
      "timeout": 90,
      "docker_argv": [
        "docker",
        "compose",
        "-f",
        "${REPO}/docker-compose.rpi.yml",
        "--profile",
        "farmacias",
        "exec",
        "-T",
        "farmacias",
        "python",
        "-u",
        "/app/tools/farmacias_guardia/farmacias_guardia.py",
        "doctor"
      ]
    }
  ]
}
