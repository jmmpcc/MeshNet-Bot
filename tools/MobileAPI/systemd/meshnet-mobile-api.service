[Unit]
Description=MeshNet Mobile API v1
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=meshnet
Group=meshnet
WorkingDirectory=/home/meshnet/MeshNet-Bot
EnvironmentFile=-/home/meshnet/MeshNet-Bot/tools/MobileAPI/.env
ExecStart=/home/meshnet/MeshNet-Bot/tools/ControlPanel/.venv/bin/python -m uvicorn tools.MobileAPI.mobile_api_entrypoint:app --host 0.0.0.0 --port 8791
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
