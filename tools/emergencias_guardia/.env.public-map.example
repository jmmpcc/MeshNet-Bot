# ============================================================
# MAPA PÚBLICO DE EMERGENCIAS · MeshNet
# ============================================================
# Copiar únicamente estas variables al .env real de emergencias_guardia.
# El publicador permanece totalmente desactivado mientras ENABLED=0.

EMERGENCIAS_PUBLIC_MAP_ENABLED=0

# URL pública final. No incluye /emergencias porque el módulo añade esa ruta.
EMERGENCIAS_PUBLIC_MAP_BASE_URL=https://ciberforense.com.es

# La página comprueba events.json sin recargarse. El mínimo efectivo es 5 s.
EMERGENCIAS_PUBLIC_MAP_REFRESH_SECONDS=10

# Google Maps JavaScript API.
# IMPORTANTE: restringir esta clave en Google Cloud por HTTP referrer exclusivamente a:
#   https://ciberforense.com.es/emergencias/*
# y limitarla a Maps JavaScript API. La clave es visible en el navegador por diseño.
EMERGENCIAS_PUBLIC_MAP_GOOGLE_MAPS_API_KEY=

# Publicación FTPS explícita. Puede reutilizar la misma cuenta operativa empleada por
# RadioPropagacion si esa cuenta tiene acceso a /public_html/emergencias.
EMERGENCIAS_PUBLIC_MAP_FTP_HOST=ciberforense.com.es
EMERGENCIAS_PUBLIC_MAP_FTP_PORT=21
EMERGENCIAS_PUBLIC_MAP_FTP_USER=
EMERGENCIAS_PUBLIC_MAP_FTP_PASSWORD=
EMERGENCIAS_PUBLIC_MAP_FTP_PUBLIC_ROOT=/public_html

# Mantiene el comportamiento tolerante del publicador de RadioPropagacion en hosting
# compartido. Activarlo sólo si el certificado del servidor FTPS valida correctamente
# contra el nombre utilizado en EMERGENCIAS_PUBLIC_MAP_FTP_HOST.
EMERGENCIAS_PUBLIC_MAP_FTP_SSL_VERIFY=0

# Rutas locales opcionales. En la instalación estándar no hace falta definirlas.
# EMERGENCIAS_PUBLIC_MAP_CURRENT_FILE=/home/meshnet/MeshNet-Bot/tools/emergencias_guardia/data/current.json
# EMERGENCIAS_PUBLIC_MAP_STATE_FILE=/home/meshnet/MeshNet-Bot/tools/emergencias_guardia/data/public_map_state.json

# Control Panel: acceso al mismo mapa público, sin iframe ni exposición de APIs internas.
CONTROLPANEL_PUBLIC_EMERGENCY_MAP_URL=https://ciberforense.com.es/emergencias/
