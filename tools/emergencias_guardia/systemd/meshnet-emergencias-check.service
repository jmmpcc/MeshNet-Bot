[Unit]
Description=Actualización local de emergencias
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=meshnet
WorkingDirectory=/home/meshnet/MeshNet-Bot/tools/emergencias_guardia
# Variables compartidas del proyecto (APRS, dispatcher y credenciales comunes).
EnvironmentFile=-/home/meshnet/MeshNet-Bot/.env
# Configuración específica de Emergencias; al cargarse después puede sobrescribir valores comunes.
EnvironmentFile=-/home/meshnet/MeshNet-Bot/tools/emergencias_guardia/.env
ExecStart=/usr/bin/python3 /home/meshnet/MeshNet-Bot/tools/emergencias_guardia/emergencias_guardia.py check --notify-changes
