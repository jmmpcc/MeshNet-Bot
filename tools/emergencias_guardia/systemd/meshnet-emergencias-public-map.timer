[Unit]
Description=Comprobación de respaldo del mapa público de emergencias MeshNet

[Timer]
# Respaldo con reloj independiente de los eventos de .path.
# La comprobación cada minuto NO implica conexión: publish_if_changed()
# evita subidas sin cambios y bloquea intentos durante 10 min tras error.
# El reloj independiente garantiza un reintento aun con cambios frecuentes.
OnBootSec=30s
OnCalendar=*-*-* *:*:00
AccuracySec=5s
Unit=meshnet-emergencias-public-map.service

[Install]
WantedBy=timers.target
