[Unit]
Description=Farmacias: difusión diaria completa desactivada (compatibilidad)
After=network-online.target docker.service meshnet-farmacias-api.service

[Service]
Type=oneshot
User=meshnet
WorkingDirectory=/home/meshnet/MeshNet-Bot/tools/farmacias_guardia
# No se realiza publicación automática de listados completos.
# El comando manual farmacias_guardia.py send sigue disponible.
# Los avisos de nuevas farmacias corresponden exclusivamente a farmacias-check.
ExecStart=/usr/bin/true
