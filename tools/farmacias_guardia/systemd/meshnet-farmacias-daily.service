[Unit]
Description=Envío diario de farmacias de guardia
After=network-online.target docker.service meshnet-farmacias-api.service

[Service]
Type=oneshot
User=meshnet
WorkingDirectory=/home/meshnet/MeshNet-Bot/tools/farmacias_guardia
ExecStart=/usr/bin/python3 /home/meshnet/MeshNet-Bot/tools/farmacias_guardia/farmacias_guardia.py send
