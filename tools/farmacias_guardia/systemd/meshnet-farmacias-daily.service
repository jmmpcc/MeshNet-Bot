[Unit]
Description=Envío diario de farmacias de guardia
After=network-online.target docker.service meshnet-farmacias-api.service

[Service]
Type=oneshot
User=meshnet
WorkingDirectory=/home/meshnet/MeshNet-Bot/tools/farmacias_guardia
# El launcher scoped delega en el flujo histórico equivalente a: farmacias_guardia.py send
ExecStart=/usr/bin/python3 /home/meshnet/MeshNet-Bot/tools/farmacias_guardia/farmacias_guardia_scoped.py send
