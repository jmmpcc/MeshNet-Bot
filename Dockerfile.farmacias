FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    TZ=Europe/Madrid \
    PYTHONPATH=/app

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates tzdata \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Aplicación independiente y helpers compartidos. No se copia el broker ni el bot:
# esta imagen contiene únicamente lo necesario para Farmacias de Guardia.
COPY shared/ /app/shared/
COPY tools/farmacias_guardia/ /app/tools/farmacias_guardia/
COPY docker/entrypoint_farmacias_api.sh /usr/local/bin/
COPY docker/entrypoint_farmacias_check.sh /usr/local/bin/
COPY docker/entrypoint_farmacias_daily.sh /usr/local/bin/

RUN chmod +x \
        /usr/local/bin/entrypoint_farmacias_api.sh \
        /usr/local/bin/entrypoint_farmacias_check.sh \
        /usr/local/bin/entrypoint_farmacias_daily.sh \
    && python -m py_compile \
        /app/tools/farmacias_guardia/farmacias_guardia.py \
        /app/tools/farmacias_guardia/farmacias_guardia_scoped.py \
    && PYTHONPATH=/app python -c "import tools.farmacias_guardia.farmacias_guardia"

VOLUME ["/app/bot_data"]

CMD ["/usr/local/bin/entrypoint_farmacias_api.sh"]
