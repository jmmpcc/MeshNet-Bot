[Unit]
Description=Comprobación de cambios en farmacias de guardia
After=network-online.target docker.service meshnet-farmacias-api.service

[Service]
Type=oneshot
User=meshnet
WorkingDirectory=/home/meshnet/farmacias_guardia
ExecStart=/usr/bin/python3 /home/meshnet/farmacias_guardia/farmacias_guardia.py check --send
